# Mengabaikan folder dependensi (Ini yang membuat error sebelumnya)
node_modules/
frontend/node_modules/

# Mengabaikan file log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Mengabaikan folder hasil build dan cache
build/
dist/
.cache/
frontend/.cache/

# Mengabaikan file environment (keamanan)
.env
.env.local
.env.development.local
.env.production.local

# Mengabaikan file bawaan sistem operasi
.DS_Store
Thumbs.db