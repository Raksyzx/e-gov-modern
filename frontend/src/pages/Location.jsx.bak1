import { useEffect, useState } from "react";
import { MapPin, Clock, Building2, Phone } from "lucide-react";
import api from "@/lib/api";
import { Card, CardContent } from "@/components/ui/card";

export default function Location() {
  const [info, setInfo] = useState(null);
  useEffect(() => { api.get("/info").then((r) => setInfo(r.data)); }, []);

  return (
    <div className="space-y-6" data-testid="location-page">
      <div>
        <div className="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-brand-blue mb-2">
          <MapPin className="h-4 w-4" /> Lokasi & Layanan
        </div>
        <h1 className="font-display font-bold text-3xl md:text-4xl">Kantor Kelurahan</h1>
        <p className="text-muted-foreground mt-1">Alamat, jam operasional, dan lokasi pelayanan warga.</p>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div className="lg:col-span-2 rounded-2xl overflow-hidden border" data-testid="map-container">
          <iframe
            title="Lokasi Kantor Kelurahan"
            src="https://www.google.com/maps?q=Kantor+Kelurahan+Kagungan&output=embed"
            width="100%"
            height="480"
            style={{ border: 0 }}
            loading="lazy"
            referrerPolicy="no-referrer-when-downgrade"
          />
        </div>

        <div className="space-y-4">
          <Card data-testid="office-info">
            <CardContent className="p-5 space-y-4">
              <div>
                <div className="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-brand-blue mb-1">
                  <Building2 className="h-4 w-4" /> Alamat
                </div>
                <div className="font-medium">{info?.address || "-"}</div>
                <div className="text-sm text-muted-foreground">{info?.wilayah || "-"}</div>
              </div>
              <div>
                <div className="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-brand-green mb-1">
                  <Clock className="h-4 w-4" /> Jam Operasional
                </div>
                <div className="text-sm">{info?.office_hours || "-"}</div>
              </div>
              <div>
                <div className="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-brand-orange mb-1">
                  <Phone className="h-4 w-4" /> Kontak
                </div>
                <a href="tel:0215551234" className="text-sm font-medium text-brand-blue hover:underline">021-5551234</a>
              </div>
            </CardContent>
          </Card>

          <Card>
            <CardContent className="p-5">
              <div className="text-xs uppercase tracking-widest font-semibold text-muted-foreground mb-2">Statistik Wilayah</div>
              <div className="grid grid-cols-2 gap-3 text-sm">
                <div>
                  <div className="text-xs text-muted-foreground">Total RT</div>
                  <div className="font-display font-bold text-2xl">{info?.total_rt || 0}</div>
                </div>
                <div>
                  <div className="text-xs text-muted-foreground">Total RW</div>
                  <div className="font-display font-bold text-2xl">{info?.total_rw || 0}</div>
                </div>
                <div>
                  <div className="text-xs text-muted-foreground">Kepala Keluarga</div>
                  <div className="font-display font-bold text-2xl">{info?.total_kk?.toLocaleString("id-ID") || 0}</div>
                </div>
                <div>
                  <div className="text-xs text-muted-foreground">Penduduk</div>
                  <div className="font-display font-bold text-2xl">{info?.total_penduduk?.toLocaleString("id-ID") || 0}</div>
                </div>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  );
