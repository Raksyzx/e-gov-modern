import { useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { Shield, ArrowLeft } from "lucide-react";
import { toast } from "sonner";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { useAuth } from "@/context/AuthContext";
import { formatApiError } from "@/lib/api";

export default function AdminLogin() {
  const [email, setEmail] = useState("admin@kelurahan.id");
  const [password, setPassword] = useState("");
  const [loading, setLoading] = useState(false);
  const { login } = useAuth();
  const navigate = useNavigate();

  const submit = async (e) => {
    e.preventDefault();
    setLoading(true);
    try {
      await login(email, password);
      toast.success("Login berhasil");
      navigate("/admin");
    } catch (err) {
      toast.error(formatApiError(err));
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen flex items-center justify-center bg-background p-4" data-testid="admin-login-page">
      <div className="w-full max-w-md">
        <Link to="/" className="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground mb-6" data-testid="link-back-home">
          <ArrowLeft className="h-4 w-4" /> Kembali ke Dashboard
        </Link>
        <Card>
          <CardContent className="p-8">
            <div className="flex items-center gap-3 mb-6">
              <div className="w-12 h-12 rounded-xl brand-blue flex items-center justify-center">
                <Shield className="h-6 w-6" />
              </div>
              <div>
                <h1 className="font-display font-bold text-xl">Login Admin</h1>
                <p className="text-xs text-muted-foreground">Panel pengelolaan konten kelurahan</p>
              </div>
            </div>
            <form onSubmit={submit} className="space-y-4">
              <div>
                <Label htmlFor="email">Email</Label>
                <Input
                  id="email"
                  type="email"
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  className="min-h-[44px] mt-1"
                  data-testid="input-email"
                  required
                />
              </div>
              <div>
                <Label htmlFor="password">Password</Label>
                <Input
                  id="password"
                  type="password"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  className="min-h-[44px] mt-1"
                  placeholder="Masukkan password admin"
                  data-testid="input-password"
                  required
                />
              </div>
              <Button
                type="submit"
                disabled={loading}
                className="w-full brand-blue hover:brightness-90 min-h-[44px] font-semibold"
                data-testid="btn-login"
              >
                {loading ? "Memuat..." : "Masuk"}
              </Button>
            </form>
            <div className="mt-4 text-xs text-muted-foreground text-center">
              Demo: <span className="font-mono">admin@kelurahan.id</span> / <span className="font-mono">admin123</span>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  );
}
