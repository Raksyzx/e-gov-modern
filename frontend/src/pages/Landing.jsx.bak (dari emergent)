import { Card, CardContent } from "@/components/ui/card";
import { Avatar, AvatarImage, AvatarFallback } from "@/components/ui/avatar";

function useClock() {
  const [now, setNow] = useState(new Date());
  useEffect(() => {
    const t = setInterval(() => setNow(new Date()), 1000);
    return () => clearInterval(t);
  }, []);
  return now;
}

function PengurusNode({ p, size = "md" }) {
  const sizes = {
    sm: { avatar: "h-14 w-14", text: "text-xs", name: "text-sm" },
    md: { avatar: "h-16 w-16", text: "text-xs", name: "text-sm" },
    lg: { avatar: "h-20 w-20", text: "text-xs", name: "text-base" },
  }[size];
  return (
    <div className="flex flex-col items-center text-center px-3 py-4 rounded-xl bg-card border shadow-sm min-w-[160px]" data-testid={`org-node-${p.id}`}>
      <Avatar className={`${sizes.avatar} border-2 border-secondary/40 mb-2`}>
        <AvatarImage src={toAbsoluteUrl(p.photo_url)} alt={p.name} />
        <AvatarFallback className="brand-green font-display">{p.name.charAt(0)}</AvatarFallback>
      </Avatar>
      <div className={`${sizes.text} uppercase tracking-widest text-brand-green font-semibold`}>{p.position}</div>
      <div className={`${sizes.name} font-display font-semibold leading-tight mt-1`}>{p.name}</div>
    </div>
  );
}

