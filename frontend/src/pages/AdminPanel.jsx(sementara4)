  };

  // --- FUNGSI CRUD BARU (PENDIDIKAN & UMKM) ---
  const savePendidikan = async (payload) => {
    try {
      if (editingPendidikan) {
        const { error } = await supabase.from("pendidikan").update(payload).eq("id", editingPendidikan.id);
        if (error) throw error;
      } else {
        const { error } = await supabase.from("pendidikan").insert([payload]);
        if (error) throw error;
      }
      toast.success("Data Pendidikan tersimpan");
      setOpenPendidikan(false); setEditingPendidikan(null); load();
    } catch (e) { toast.error(e.message || "Gagal menyimpan data Pendidikan"); }
  };

  const delPendidikan = async (id) => {
    if (!window.confirm("Hapus data pendidikan ini?")) return;
    try {
      const { error } = await supabase.from("pendidikan").delete().eq("id", id);
      if (error) throw error;
      toast.success("Terhapus"); load();
    } catch (e) { toast.error(e.message || "Gagal menghapus data Pendidikan"); }
