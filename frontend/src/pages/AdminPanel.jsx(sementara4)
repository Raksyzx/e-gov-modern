      const { error } = await supabase.from("info").update({ has_draft: false, is_draft: false }).eq("id", 1);
      if (error) throw error;
      toast.success("Draft dibatalkan");
      load();
    } catch (e) { toast.error(e.message || "Gagal membatalkan draft"); }
  };

  const addAnn = async () => {
    try {
      const { error } = await supabase.from("announcements").insert([annForm]);
      if (error) throw error;
      toast.success("Pengumuman ditambahkan");
      setAnnForm({ title: "", body: "", priority: "normal" });
      setOpenAnn(false); load();
