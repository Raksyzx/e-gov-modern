          <TabsTrigger value="info" data-testid="tab-info">Info & Statistik</TabsTrigger>
          <TabsTrigger value="pengurus" data-testid="tab-pengurus">Pengurus ({pengurus.length})</TabsTrigger>
          <TabsTrigger value="contacts" data-testid="tab-contacts">Kontak ({contacts.length})</TabsTrigger>
          <TabsTrigger value="pendidikan">Pendidikan ({pendidikan.length})</TabsTrigger>
          <TabsTrigger value="umkm">UMKM ({umkm.length})</TabsTrigger>
          <TabsTrigger value="announcements" data-testid="tab-announcements">Pengumuman ({announcements.length})</TabsTrigger>
          <TabsTrigger value="agenda" data-testid="tab-agenda">Agenda ({agenda.length})</TabsTrigger>
          <TabsTrigger value="preview" data-testid="tab-preview">Preview Landing</TabsTrigger>
        </TabsList>

        {/* INFO TAB */}
        <TabsContent value="info" className="mt-4">
          {info && (
            <Card><CardContent className="p-6 space-y-4">
              <h3 className="font-display font-semibold text-lg">Statistik Kelurahan</h3>
              <div className="grid grid-cols-2 md:grid-cols-5 gap-3">
                <div><Label>Total KK</Label><Input type="number" value={info.total_kk || 0} onChange={(e) => setInfo({ ...info, total_kk: parseInt(e.target.value || "0") })} data-testid="input-info-kk" /></div>
                <div><Label>Total Penduduk</Label><Input type="number" value={info.total_penduduk || 0} onChange={(e) => setInfo({ ...info, total_penduduk: parseInt(e.target.value || "0") })} data-testid="input-info-penduduk" /></div>
                <div><Label>Total RT</Label><Input type="number" value={info.total_rt || 0} onChange={(e) => setInfo({ ...info, total_rt: parseInt(e.target.value || "0") })} data-testid="input-info-rt" /></div>
                <div><Label>Total RW</Label><Input type="number" value={info.total_rw || 0} onChange={(e) => setInfo({ ...info, total_rw: parseInt(e.target.value || "0") })} data-testid="input-info-rw" /></div>
                <div><Label>Total Kader</Label><Input type="number" value={info.total_kader || 0} onChange={(e) => setInfo({ ...info, total_kader: parseInt(e.target.value || "0") })} data-testid="input-info-kader" /></div>
              </div>
              <h3 className="font-display font-semibold text-lg pt-4">Profil Kelurahan</h3>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div><Label>Nama Kelurahan</Label><Input value={info.name || ""} onChange={(e) => setInfo({ ...info, name: e.target.value })} data-testid="input-info-name" /></div>
                <div><Label>Wilayah (Kecamatan/Kota)</Label><Input value={info.wilayah || ""} onChange={(e) => setInfo({ ...info, wilayah: e.target.value })} data-testid="input-info-wilayah" /></div>
                <div className="md:col-span-2"><Label>Alamat</Label><Input value={info.address || ""} onChange={(e) => setInfo({ ...info, address: e.target.value })} data-testid="input-info-address" /></div>
                <div className="md:col-span-2"><Label>Jam Operasional</Label><Input value={info.office_hours || ""} onChange={(e) => setInfo({ ...info, office_hours: e.target.value })} data-testid="input-info-hours" /></div>
              </div>
              <h3 className="font-display font-semibold text-lg pt-4">Tampilan Landing Page</h3>
              <div className="space-y-3">
                <div><Label>Foto Background Landing</Label><Uploader value={info.hero_bg_url || ""} onChange={(v) => setInfo({ ...info, hero_bg_url: v })} label="Background Hero" testid="uploader-hero" /></div>
                <div><Label>Tagline Hero</Label><Textarea value={info.hero_tagline || ""} onChange={(e) => setInfo({ ...info, hero_tagline: e.target.value })} rows={2} data-testid="input-info-tagline" /></div>
              </div>
              <div className="flex justify-between items-center pt-2 gap-2 flex-wrap" data-testid="draft-actions">
                <div className="text-xs">
                  {hasDraft ? (
                    <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full brand-orange text-xs font-semibold" data-testid="draft-badge">
                      <AlertCircle className="h-3 w-3" /> Ada perubahan draft belum dipublikasikan
                    </span>
                  ) : (
                    <span className="text-muted-foreground">Semua perubahan sudah tayang.</span>
                  )}
                </div>
                <div className="flex gap-2">
                  {hasDraft && (
                    <Button variant="outline" onClick={discardDraft} className="gap-1" data-testid="btn-discard-draft">
                      <RotateCcw className="h-4 w-4" /> Batalkan Draft
                    </Button>
                  )}
                  <Button onClick={saveInfo} variant="outline" data-testid="btn-save-info">Simpan Draft</Button>
                  <Button onClick={publishInfo} disabled={!hasDraft} className="brand-green hover:brightness-90 gap-1" data-testid="btn-publish-info">
                    <Send className="h-4 w-4" /> Publish
                  </Button>
                </div>
              </div>
            </CardContent></Card>
          )}

          {/* Publish audit log */}
          <Card data-testid="publish-log-card" className="mt-4">
            <CardContent className="p-6">
              <div className="flex items-center gap-2 mb-4">
                <History className="h-5 w-5 text-brand-blue" />
                <h3 className="font-display font-semibold">Riwayat Publish ({publishLog.length})</h3>
              </div>
              {publishLog.length === 0 ? (
                <div className="text-sm text-muted-foreground text-center py-6">Belum ada riwayat publish.</div>
              ) : (
                <div className="space-y-3" data-testid="publish-log-list">
                  {publishLog.map((entry) => (
                    <div key={entry.id} className="flex items-start gap-3 p-3 rounded-lg border bg-muted/30" data-testid={`log-entry-${entry.id}`}>
                      <div className="w-9 h-9 rounded-full brand-blue flex items-center justify-center shrink-0">
                        <User className="h-4 w-4" />
                      </div>
                      <div className="flex-1 min-w-0">
                        <div className="flex items-center justify-between gap-2 flex-wrap">
                          <div className="font-semibold text-sm">{entry.user_email}</div>
                          <div className="text-xs text-muted-foreground tabular-nums">
                            {new Date(entry.published_at).toLocaleString("id-ID", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" })}
                          </div>
                        </div>
                        {entry.changed_fields?.length > 0 ? (
                          <div className="flex flex-wrap gap-1 mt-2">
                            {entry.changed_fields.map((f) => (
                              <span key={f} className="text-[10px] px-2 py-0.5 rounded-full bg-secondary/15 text-secondary font-mono font-semibold uppercase">{f}</span>
                            ))}
                          </div>
                        ) : (
                          <div className="text-xs text-muted-foreground mt-1">Tidak ada perubahan tercatat</div>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </CardContent></Card>
        </TabsContent>

        {/* PENGURUS TAB */}
        <TabsContent value="pengurus" className="space-y-4 mt-4">
          <div className="flex justify-between items-center">
            <p className="text-xs text-muted-foreground">Seret <GripVertical className="inline h-3 w-3" /> untuk mengubah urutan tampilan.</p>
            <Dialog open={openPengurus} onOpenChange={(v) => { setOpenPengurus(v); if (!v) setEditingPengurus(null); }}>
              <DialogTrigger asChild>
                <Button className="brand-blue hover:brightness-90 gap-1" onClick={() => setEditingPengurus(null)} data-testid="btn-add-pengurus"><Plus className="h-4 w-4" /> Pengurus Baru</Button>
              </DialogTrigger>
              <DialogContent className="max-w-2xl max-h-[85vh] overflow-y-auto">
                <DialogHeader><DialogTitle>{editingPengurus ? "Edit" : "Tambah"} Pengurus</DialogTitle></DialogHeader>
                <PengurusForm key={editingPengurus?.id || "new"} initial={editingPengurus} onSubmit={savePengurus} />
              </DialogContent>
            </Dialog>
          </div>
          <SortablePengurus items={pengurus} onReorder={reorderPengurus} onEdit={(p) => { setEditingPengurus(p); setOpenPengurus(true); }} onDelete={delPengurus} />
        </TabsContent>

        {/* CONTACTS TAB */}
        <TabsContent value="contacts" className="space-y-4 mt-4">
          <div className="flex justify-end">
            <Dialog open={openContact} onOpenChange={(v) => { setOpenContact(v); if (!v) setEditingContact(null); }}>
              <DialogTrigger asChild>
                <Button className="brand-blue hover:brightness-90 gap-1" onClick={() => setEditingContact(null)} data-testid="btn-add-contact"><Plus className="h-4 w-4" /> Kontak Baru</Button>
              </DialogTrigger>
              <DialogContent className="max-w-2xl max-h-[85vh] overflow-y-auto">
                <DialogHeader><DialogTitle>{editingContact ? "Edit" : "Tambah"} Kontak</DialogTitle></DialogHeader>
                <ContactForm key={editingContact?.id || "new"} initial={editingContact} onSubmit={saveContact} />
              </DialogContent>
            </Dialog>
          </div>
          <Card><CardContent className="p-0 divide-y">
            {contacts.map((c) => (
              <div key={c.id} className="p-4 flex items-center justify-between gap-4" data-testid={`admin-contact-${c.id}`}>
                <div className="min-w-0">
                  <div className="font-semibold truncate">{c.name} <span className="text-xs text-muted-foreground">· {c.category}/{c.subcategory}</span></div>
                  <div className="text-xs text-muted-foreground">{c.role} · {c.phone}</div>
                </div>
                <div className="flex gap-1">
                  <Button size="icon" variant="ghost" onClick={() => { setEditingContact(c); setOpenContact(true); }} data-testid={`btn-edit-contact-${c.id}`}><Pencil className="h-4 w-4" /></Button>
                  <Button size="icon" variant="ghost" onClick={() => delContact(c.id)} data-testid={`btn-del-contact-${c.id}`}><Trash2 className="h-4 w-4 text-brand-red" /></Button>
                </div>
              </div>
            ))}
          </CardContent></Card>
        </TabsContent>

        {/* PENDIDIKAN TAB (BARU) */}
        <TabsContent value="pendidikan" className="space-y-4 mt-4">
          <div className="flex justify-end">
            <Dialog open={openPendidikan} onOpenChange={(v) => { setOpenPendidikan(v); if (!v) setEditingPendidikan(null); }}>
              <DialogTrigger asChild><Button className="brand-blue hover:brightness-90 gap-1"><Plus className="h-4 w-4" /> Data Pendidikan Baru</Button></DialogTrigger>
              <DialogContent className="max-w-2xl max-h-[85vh] overflow-y-auto">
                <DialogHeader><DialogTitle>{editingPendidikan ? "Edit" : "Tambah"} Pendidikan</DialogTitle></DialogHeader>
                <PendidikanForm key={editingPendidikan?.id || "new"} initial={editingPendidikan} onSubmit={savePendidikan} />
              </DialogContent>
            </Dialog>
          </div>
          <Card><CardContent className="p-0 divide-y">
            {pendidikan.map((p) => (
              <div key={p.id} className="p-4 flex items-center justify-between gap-4">
                <div className="min-w-0">
                  <div className="font-semibold truncate">{p.nama_sekolah} <span className="text-xs font-bold text-brand-blue">· {p.jenis_sekolah}</span></div>
                  <div className="text-xs text-muted-foreground line-clamp-1">{p.lokasi}</div>
                </div>
                <div className="flex gap-1">
                  <Button size="icon" variant="ghost" onClick={() => { setEditingPendidikan(p); setOpenPendidikan(true); }}><Pencil className="h-4 w-4" /></Button>
                  <Button size="icon" variant="ghost" onClick={() => delPendidikan(p.id)}><Trash2 className="h-4 w-4 text-brand-red" /></Button>
                </div>
              </div>
            ))}
            {pendidikan.length === 0 && <div className="p-4 text-center text-muted-foreground text-sm">Belum ada data pendidikan.</div>}
          </CardContent></Card>
        </TabsContent>

        {/* UMKM TAB (BARU) */}
        <TabsContent value="umkm" className="space-y-4 mt-4">
          <div className="flex justify-end">
            <Dialog open={openUmkm} onOpenChange={(v) => { setOpenUmkm(v); if (!v) setEditingUmkm(null); }}>
              <DialogTrigger asChild><Button className="bg-orange-500 hover:bg-orange-600 text-white gap-1"><Plus className="h-4 w-4" /> UMKM Baru</Button></DialogTrigger>
              <DialogContent className="max-w-2xl max-h-[85vh] overflow-y-auto">
                <DialogHeader><DialogTitle>{editingUmkm ? "Edit" : "Tambah"} UMKM</DialogTitle></DialogHeader>
                <UmkmForm key={editingUmkm?.id || "new"} initial={editingUmkm} onSubmit={saveUmkm} />
              </DialogContent>
            </Dialog>
          </div>
          <Card><CardContent className="p-0 divide-y">
            {umkm.map((u) => (
              <div key={u.id} className="p-4 flex items-center justify-between gap-4">
                <div className="min-w-0">
                  <div className="font-semibold truncate">{u.nama_umkm} <span className="text-xs text-muted-foreground font-normal">({u.nama_pemilik})</span></div>
                  <div className="text-xs text-muted-foreground line-clamp-1">{u.alamat} · {u.no_hp}</div>
                </div>
                <div className="flex gap-1">
                  <Button size="icon" variant="ghost" onClick={() => { setEditingUmkm(u); setOpenUmkm(true); }}><Pencil className="h-4 w-4" /></Button>
                  <Button size="icon" variant="ghost" onClick={() => delUmkm(u.id)}><Trash2 className="h-4 w-4 text-brand-red" /></Button>
                </div>
              </div>
            ))}
            {umkm.length === 0 && <div className="p-4 text-center text-muted-foreground text-sm">Belum ada data UMKM.</div>}
          </CardContent></Card>
        </TabsContent>

        {/* ANNOUNCEMENTS TAB */}
        <TabsContent value="announcements" className="space-y-4 mt-4">
          <div className="flex justify-end">
            <Dialog open={openAnn} onOpenChange={setOpenAnn}>
              <DialogTrigger asChild><Button className="brand-blue hover:brightness-90 gap-1" data-testid="btn-add-announcement"><Plus className="h-4 w-4" /> Pengumuman Baru</Button></DialogTrigger>
              <DialogContent>
                <DialogHeader><DialogTitle>Tambah Pengumuman</DialogTitle></DialogHeader>
                <div className="space-y-3">
                  <div><Label>Judul</Label><Input value={annForm.title} onChange={(e) => setAnnForm({ ...annForm, title: e.target.value })} data-testid="input-ann-title" /></div>
                  <div><Label>Isi</Label><Textarea value={annForm.body} onChange={(e) => setAnnForm({ ...annForm, body: e.target.value })} data-testid="input-ann-body" /></div>
                  <div>
                    <Label>Prioritas</Label>
                    <Select value={annForm.priority} onValueChange={(v) => setAnnForm({ ...annForm, priority: v })}>
                      <SelectTrigger data-testid="input-ann-priority"><SelectValue /></SelectTrigger>
                      <SelectContent><SelectItem value="normal">Normal</SelectItem><SelectItem value="urgent">Urgent</SelectItem></SelectContent>
                    </Select>
                  </div>
                </div>
                <DialogFooter><Button onClick={addAnn} className="brand-blue hover:brightness-90" data-testid="btn-save-announcement">Simpan</Button></DialogFooter>
              </DialogContent>
            </Dialog>
          </div>
          <Card><CardContent className="p-0 divide-y">
            {announcements.map((a) => (
              <div key={a.id} className="p-4 flex items-start justify-between gap-4">
                <div className="min-w-0">
                  <div className="font-semibold">{a.title} {a.priority === "urgent" && <span className="text-xs text-brand-red">· URGENT</span>}</div>
                  <div className="text-xs text-muted-foreground line-clamp-2">{a.body}</div>
                </div>
                <Button size="icon" variant="ghost" onClick={() => delAnn(a.id)}><Trash2 className="h-4 w-4 text-brand-red" /></Button>
              </div>
            ))}
          </CardContent></Card>
        </TabsContent>

        {/* AGENDA TAB */}
        <TabsContent value="agenda" className="space-y-4 mt-4">
          <div className="flex justify-end">
            <Dialog open={openAg} onOpenChange={setOpenAg}>
              <DialogTrigger asChild><Button className="brand-blue hover:brightness-90 gap-1" data-testid="btn-add-agenda"><Plus className="h-4 w-4" /> Agenda Baru</Button></DialogTrigger>
              <DialogContent>
                <DialogHeader><DialogTitle>Tambah Agenda</DialogTitle></DialogHeader>
                <div className="grid grid-cols-2 gap-3">
                  <div className="col-span-2"><Label>Judul</Label><Input value={agForm.title} onChange={(e) => setAgForm({ ...agForm, title: e.target.value })} data-testid="input-ag-title" /></div>
                  <div><Label>Tanggal</Label><Input type="date" value={agForm.date} onChange={(e) => setAgForm({ ...agForm, date: e.target.value })} data-testid="input-ag-date" /></div>
                  <div><Label>Waktu</Label><Input value={agForm.time} onChange={(e) => setAgForm({ ...agForm, time: e.target.value })} placeholder="19.30 WIB" data-testid="input-ag-time" /></div>
                  <div className="col-span-2"><Label>Lokasi</Label><Input value={agForm.location} onChange={(e) => setAgForm({ ...agForm, location: e.target.value })} data-testid="input-ag-location" /></div>
                  <div className="col-span-2"><Label>Deskripsi</Label><Textarea value={agForm.description} onChange={(e) => setAgForm({ ...agForm, description: e.target.value })} data-testid="input-ag-desc" /></div>
                </div>
                <DialogFooter><Button onClick={addAg} className="brand-blue hover:brightness-90" data-testid="btn-save-agenda">Simpan</Button></DialogFooter>
              </DialogContent>
            </Dialog>
          </div>
          <Card><CardContent className="p-0 divide-y">
            {agenda.map((a) => (
              <div key={a.id} className="p-4 flex items-center justify-between gap-4">
                <div>
                  <div className="font-semibold">{a.title}</div>
                  <div className="text-xs text-muted-foreground">{a.date} · {a.time} · {a.location}</div>
                </div>
                <Button size="icon" variant="ghost" onClick={() => delAg(a.id)}><Trash2 className="h-4 w-4 text-brand-red" /></Button>
              </div>
            ))}
          </CardContent></Card>
        </TabsContent>

        {/* PREVIEW TAB */}
        <TabsContent value="preview" className="space-y-4 mt-4" data-testid="preview-tab-content">
          <Card><CardContent className="p-4">
            <div className="flex items-center justify-between mb-3 flex-wrap gap-3">
              <div>
                <h3 className="font-display font-semibold">Preview Landing Page (Live)</h3>
                <p className="text-xs text-muted-foreground">Refresh setelah menyimpan perubahan di tab Info.</p>
              </div>
              <div className="flex items-center gap-2">
                <div className="flex rounded-lg border bg-muted p-1" data-testid="preview-mode-toggle">
                  <Button size="sm" variant={previewMode === "desktop" ? "default" : "ghost"} onClick={() => setPreviewMode("desktop")} className="gap-1 h-8" data-testid="preview-desktop">
                    <Monitor className="h-4 w-4" /> Desktop
                  </Button>
                  <Button size="sm" variant={previewMode === "tablet" ? "default" : "ghost"} onClick={() => setPreviewMode("tablet")} className="gap-1 h-8" data-testid="preview-tablet">
                    <Tablet className="h-4 w-4" /> Tablet
                  </Button>
                  <Button size="sm" variant={previewMode === "mobile" ? "default" : "ghost"} onClick={() => setPreviewMode("mobile")} className="gap-1 h-8" data-testid="preview-mobile">
                    <Smartphone className="h-4 w-4" /> Mobile
                  </Button>
                </div>
                <Button variant="outline" size="sm" onClick={() => { const f = document.getElementById("landing-preview-frame"); if (f) f.src = `/?t=${Date.now()}`; }} data-testid="btn-refresh-preview">Refresh</Button>
                <a href="/" target="_blank" rel="noreferrer" data-testid="btn-open-landing">
                  <Button size="sm" className="brand-blue hover:brightness-90 gap-1"><ExternalLink className="h-4 w-4" /> Buka Baru</Button>
                </a>
              </div>
            </div>
            <div className="border rounded-lg overflow-hidden bg-muted/40 flex justify-center transition-all">
              <div style={{ width: previewWidths[previewMode], transition: "width 0.3s ease" }} className="bg-background shadow-md">
                <iframe id="landing-preview-frame" title="Preview Landing" src="/" className="w-full block" style={{ height: "70vh", border: 0 }} data-testid="landing-preview-frame" />
              </div>
            </div>
          </CardContent></Card>
        </TabsContent>
      </Tabs>
    </div>
  );
}