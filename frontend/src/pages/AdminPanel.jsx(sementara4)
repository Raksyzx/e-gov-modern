function SortablePengurusRow({ p, onEdit, onDelete }) {
  const { attributes, listeners, setNodeRef, transform, transition, isDragging } = useSortable({ id: p.id });
  const style = { transform: CSS.Transform.toString(transform), transition, opacity: isDragging ? 0.5 : 1 };
  return (
    <div ref={setNodeRef} style={style} className="p-4 flex items-center justify-between gap-4 border-b bg-card" data-testid={`admin-pengurus-${p.id}`}>
      <button {...attributes} {...listeners} className="cursor-grab active:cursor-grabbing text-muted-foreground p-1" data-testid={`drag-pengurus-${p.id}`}>
        <GripVertical className="h-5 w-5" />
      </button>
      <div className="flex items-center gap-3 min-w-0 flex-1">
        <Avatar className="h-10 w-10"><AvatarImage src={p.photo_url} /><AvatarFallback className="brand-green">{p.name ? p.name.charAt(0) : "P"}</AvatarFallback></Avatar>
        <div className="min-w-0">
          <div className="font-semibold truncate">{p.name}</div>
          <div className="text-xs text-muted-foreground">{p.position} · #{p.order}</div>
        </div>
      </div>
      <div className="flex gap-1">
        <Button size="icon" variant="ghost" onClick={() => onEdit(p)} data-testid={`btn-edit-pengurus-${p.id}`}><Pencil className="h-4 w-4" /></Button>
        <Button size="icon" variant="ghost" onClick={() => onDelete(p.id)} data-testid={`btn-del-pengurus-${p.id}`}><Trash2 className="h-4 w-4 text-brand-red" /></Button>
      </div>
    </div>
  );
}

function SortablePengurus({ items, onReorder, onEdit, onDelete }) {
  const sensors = useSensors(useSensor(PointerSensor, { activationConstraint: { distance: 5 } }));
  const handleEnd = (e) => {
    const { active, over } = e;
    if (!over || active.id === over.id) return;
    const oldIdx = items.findIndex((i) => i.id === active.id);
    const newIdx = items.findIndex((i) => i.id === over.id);
    onReorder(arrayMove(items, oldIdx, newIdx));
  };
  return (
    <Card><CardContent className="p-0">
      <DndContext sensors={sensors} collisionDetection={closestCenter} onDragEnd={handleEnd}>
        <SortableContext items={items.map((i) => i.id)} strategy={verticalListSortingStrategy}>
          {items.map((p) => <SortablePengurusRow key={p.id} p={p} onEdit={onEdit} onDelete={onDelete} />)}
        </SortableContext>
      </DndContext>
    </CardContent></Card>
  );
}

export default function AdminPanel() {
  const [contacts, setContacts] = useState([]);
  const [announcements, setAnnouncements] = useState([]);
  const [agenda, setAgenda] = useState([]);
  const [pengurus, setPengurus] = useState([]);
  const [pendidikan, setPendidikan] = useState([]); 
  const [umkm, setUmkm] = useState([]); 
  const [info, setInfo] = useState(null);
  
  const [editingContact, setEditingContact] = useState(null);
  const [editingPengurus, setEditingPengurus] = useState(null);
  const [editingPendidikan, setEditingPendidikan] = useState(null); 
  const [editingUmkm, setEditingUmkm] = useState(null); 
  
  const [openContact, setOpenContact] = useState(false);
  const [openPengurus, setOpenPengurus] = useState(false);
  const [openPendidikan, setOpenPendidikan] = useState(false); 
  const [openUmkm, setOpenUmkm] = useState(false); 
  const [openAnn, setOpenAnn] = useState(false);
  const [openAg, setOpenAg] = useState(false);
  
  const [annForm, setAnnForm] = useState({ title: "", body: "", priority: "normal" });
  const [agForm, setAgForm] = useState({ title: "", date: "", time: "", location: "", description: "" });
  const [previewMode, setPreviewMode] = useState("desktop");
  const previewWidths = { desktop: "100%", tablet: "768px", mobile: "390px" };
  const [hasDraft, setHasDraft] = useState(false);
  const [publishLog, setPublishLog] = useState([]);

  const load = async () => {
    try {
      const [cRes, aRes, gRes, pRes, iRes, logRes, pendRes, umkmRes] = await Promise.all([
        supabase.from("contacts").select("*").order("id", { ascending: false }),
        supabase.from("announcements").select("*").order("id", { ascending: false }),
        supabase.from("agenda").select("*").order("id", { ascending: false }),
        supabase.from("pengurus").select("*").order("order", { ascending: true }),
        supabase.from("info").select("*").eq("id", 1).maybeSingle(),
        supabase.from("publish_log").select("*").order("published_at", { ascending: false }),
        supabase.from("pendidikan").select("*").order("nama_sekolah", { ascending: true }), 
        supabase.from("umkm").select("*").order("nama_umkm", { ascending: true }), 
      ]);

      if (cRes.data) setContacts(cRes.data);
      if (aRes.data) setAnnouncements(aRes.data);
      if (gRes.data) setAgenda(gRes.data);
      if (pRes.data) setPengurus(pRes.data);
      if (iRes.data) {
        setInfo(iRes.data);
        setHasDraft(iRes.data.has_draft);
      }
      if (logRes.data) setPublishLog(logRes.data);
      if (pendRes.data) setPendidikan(pendRes.data); 
      if (umkmRes.data) setUmkm(umkmRes.data); 
    } catch (err) {
      toast.error("Gagal memuat data dari database");
    }
  };
  useEffect(() => { load(); }, []);

  // --- FUNGSI CRUD BAWAAN (INFO, KONTAK, PENGURUS, PENGUMUMAN, AGENDA) ---
  const saveContact = async (payload) => {
    try {
      if (editingContact) {
        const { error } = await supabase.from("contacts").update(payload).eq("id", editingContact.id);
        if (error) throw error;
      } else {
        const { error } = await supabase.from("contacts").insert([payload]);
        if (error) throw error;
      }
      toast.success("Kontak tersimpan");
      setOpenContact(false); setEditingContact(null); load();
    } catch (e) { toast.error(e.message || "Gagal menyimpan kontak"); }
  };

  const delContact = async (id) => {
    if (!window.confirm("Hapus kontak ini?")) return;
    try {
      const { error } = await supabase.from("contacts").delete().eq("id", id);
      if (error) throw error;
      toast.success("Terhapus"); load();
    } catch (e) { toast.error(e.message || "Gagal menghapus"); }
  };

  const savePengurus = async (payload) => {
    try {
      if (editingPengurus) {
        const { error } = await supabase.from("pengurus").update(payload).eq("id", editingPengurus.id);
        if (error) throw error;
      } else {
        const { error } = await supabase.from("pengurus").insert([payload]);
        if (error) throw error;
      }
      toast.success("Pengurus tersimpan");
      setOpenPengurus(false); setEditingPengurus(null); load();
    } catch (e) { toast.error(e.message || "Gagal menyimpan data pengurus"); }
  };

  const delPengurus = async (id) => {
    if (!window.confirm("Hapus pengurus ini?")) return;
    try {
      const { error } = await supabase.from("pengurus").delete().eq("id", id);
      if (error) throw error;
      toast.success("Terhapus"); load();
    } catch (e) { toast.error(e.message || "Gagal menghapus"); }
  };

  const reorderPengurus = async (newList) => {
    setPengurus(newList);
    try {
      for (let i = 0; i < newList.length; i++) {
        await supabase.from("pengurus").update({ order: i }).eq("id", newList[i].id);
      }
      toast.success("Urutan diperbarui");
      load();
    } catch (e) { toast.error("Gagal menyusun ulang urutan"); load(); }
  };

  const saveInfo = async () => {
    try {
      const updatedInfo = { ...info, has_draft: true, is_draft: true };
      const { error } = await supabase.from("info").update(updatedInfo).eq("id", 1);
      if (error) throw error;
      toast.success("Draft tersimpan — belum tayang publik. Klik Publish untuk merilis.");
      load();
    } catch (e) { toast.error(e.message || "Gagal menyimpan draft"); }
  };

  const publishInfo = async () => {
    if (!window.confirm("Publish perubahan sekarang? Konten akan langsung tayang ke publik.")) return;
    try {
      const { data: userData } = await supabase.auth.getUser();
      const userEmail = userData?.user?.email || "admin@kelurahan.id";

      const { error: infoErr } = await supabase.from("info").update({ has_draft: false, is_draft: false }).eq("id", 1);
      if (infoErr) throw infoErr;

      const { error: logErr } = await supabase.from("publish_log").insert([
        { user_email: userEmail, changed_fields: ["STATISTIK", "PROFIL", "HERO"] }
      ]);
      if (logErr) throw logErr;

      toast.success("Konten dipublikasikan");
      const f = document.getElementById("landing-preview-frame");
