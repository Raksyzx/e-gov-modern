import { useEffect, useMemo, useState } from "react";
import { Phone, MessageCircle, Search, Download, FileText, Siren } from "lucide-react";
import api from "@/lib/api";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Tabs, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Avatar, AvatarImage, AvatarFallback } from "@/components/ui/avatar";
import { downloadCsv, downloadPdf } from "@/lib/exporters";

const SUBCATS = [
  { key: "all", label: "Semua" },
  { key: "rt_rw", label: "RT/RW" },
  { key: "ambulan", label: "Ambulans" },
  { key: "pemadam", label: "Damkar" },
  { key: "polsek", label: "Polsek" },
  { key: "puskesmas", label: "Kesehatan" },
];

const STATUS_LABEL = { available: "Siap", busy: "Sibuk", offline: "Offline" };

export default function Emergency() {
  const [contacts, setContacts] = useState([]);
  const [q, setQ] = useState("");
  const [tab, setTab] = useState("all");

  useEffect(() => {
    api.get("/contacts?category=emergency").then((r) => setContacts(r.data));
  }, []);

  const filtered = useMemo(() => {
    return contacts.filter((c) => {
      if (tab !== "all" && c.subcategory !== tab) return false;
      if (!q) return true;
      const s = q.toLowerCase();
      return (
        c.name?.toLowerCase().includes(s) ||
        c.role?.toLowerCase().includes(s) ||
        c.wilayah?.toLowerCase().includes(s) ||
        c.phone?.includes(s)
      );
    });
  }, [contacts, q, tab]);

  const exportRows = filtered.map((c) => ({
    Nama: c.name,
    Jabatan: c.role,
    Kategori: c.subcategory,
    Wilayah: c.wilayah || "-",
    Telepon: c.phone,
    WhatsApp: c.whatsapp || "-",
    Status: STATUS_LABEL[c.status] || c.status,
  }));

  return (
    <div className="space-y-6" data-testid="emergency-page">
      <div className="flex items-start justify-between flex-wrap gap-4">
        <div>
          <div className="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-brand-red mb-2">
            <Siren className="h-4 w-4" /> Prioritas Utama
          </div>
          <h1 className="font-display font-bold text-3xl md:text-4xl">Kontak Darurat</h1>
          <p className="text-muted-foreground mt-1 max-w-xl">Hubungi langsung nomor darurat dengan satu ketukan. Pastikan status ketersediaan sebelum menghubungi.</p>
        </div>
        <div className="flex gap-2">
          <Button variant="outline" onClick={() => downloadCsv("kontak-darurat", exportRows)} className="gap-2 min-h-[44px]" data-testid="btn-download-csv">
            <Download className="h-4 w-4" /> CSV
          </Button>
          <Button variant="outline" onClick={() => downloadPdf("Kontak Darurat Kelurahan", exportRows)} className="gap-2 min-h-[44px]" data-testid="btn-download-pdf">
            <FileText className="h-4 w-4" /> PDF
          </Button>
        </div>
      </div>

      <div className="flex flex-col md:flex-row gap-3">
        <div className="relative flex-1">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
          <Input
            placeholder="Cari nama, jabatan, RT/RW, atau nomor..."
            value={q}
            onChange={(e) => setQ(e.target.value)}
            className="pl-10 min-h-[44px]"
            data-testid="input-search-emergency"
          />
        </div>
        <Tabs value={tab} onValueChange={setTab}>
          <TabsList className="overflow-x-auto flex" data-testid="tabs-emergency-category">
            {SUBCATS.map((s) => (
              <TabsTrigger key={s.key} value={s.key} data-testid={`tab-${s.key}`}>{s.label}</TabsTrigger>
            ))}
          </TabsList>
        </Tabs>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" data-testid="emergency-grid">
        {filtered.map((c) => (
          <Card key={c.id} className="border-l-4 border-l-red-600 card-hover" data-testid={`emergency-card-${c.id}`}>
            <CardContent className="p-5">
              <div className="flex items-start gap-3">
                <Avatar className="h-12 w-12 border">
                  {c.photo_url ? <AvatarImage src={c.photo_url} alt={c.name} /> : null}
                  <AvatarFallback className="brand-blue font-display">{c.name.charAt(0)}</AvatarFallback>
                </Avatar>
                <div className="flex-1 min-w-0">
                  <div className="text-xs uppercase tracking-widest text-brand-red font-semibold">{c.subcategory.replace("_", "/")}</div>
                  <div className="font-display font-semibold text-base truncate">{c.name}</div>
                  <div className="text-xs text-muted-foreground truncate">{c.role}</div>
                  {c.wilayah && <div className="text-xs mt-1"><span className="font-medium">{c.wilayah}</span></div>}
                </div>
                <div className="flex items-center gap-1.5 text-xs shrink-0">
                  <span className={`status-dot status-${c.status}`} />
                  <span className="text-muted-foreground">{STATUS_LABEL[c.status]}</span>
                </div>
              </div>
              {c.notes && <div className="text-xs mt-3 p-2 rounded-md bg-muted text-muted-foreground">{c.notes}</div>}
              <div className="grid grid-cols-2 gap-2 mt-4">
                <a href={`tel:${c.phone}`} data-testid={`emergency-call-${c.id}`}>
                  <Button size="sm" className="w-full brand-red hover:brightness-90 gap-1 min-h-[44px] font-semibold">
                    <Phone className="h-4 w-4" /> Hubungi
                  </Button>
                </a>
                {c.whatsapp ? (
                  <a href={`https://wa.me/${c.whatsapp}`} target="_blank" rel="noreferrer" data-testid={`emergency-wa-${c.id}`}>
                    <Button size="sm" variant="outline" className="w-full gap-1 min-h-[44px] border-green-600 text-green-600 hover:bg-green-50 dark:hover:bg-green-900/20">
                      <MessageCircle className="h-4 w-4" /> WA
                    </Button>
                  </a>
                ) : (
                  <Button size="sm" variant="outline" disabled className="min-h-[44px]">Tidak ada WA</Button>
                )}
              </div>
              <div className="text-[11px] tabular-nums text-muted-foreground mt-2 text-center">{c.phone}</div>
            </CardContent>
          </Card>
        ))}
        {filtered.length === 0 && (
          <div className="col-span-full text-center py-12 text-muted-foreground" data-testid="empty-emergency">
            Tidak ada kontak yang cocok
          </div>
        )}
      </div>
    </div>
  );
}
