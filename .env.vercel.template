# Vercel Environment Variables Template
# Copy values from your local .env.local files and paste into Vercel Dashboard
# Dashboard: Settings → Environment Variables → Add (production + preview)

# ===========================================
# FRONTEND (React/CRA - REACT_APP_ prefix)
# ===========================================
# These are exposed to the browser at build time

REACT_APP_SUPABASE_URL=https://hwajykehhncjnpowrbox.supabase.co
REACT_APP_SUPABASE_ANON_KEY=<your-new-anon-key-here>

# ===========================================
# BACKEND (FastAPI - server-side only)
# ===========================================
# These stay on server, NOT exposed to browser

MONGO_URL=<your-mongodb-connection-string>
DB_NAME=kelurahan
JWT_SECRET=<your-jwt-secret-min-32-chars>
ADMIN_EMAIL=admin@kelurahan.id
ADMIN_PASSWORD=<your-admin-password>
EMERGENT_LLM_KEY=<your-emergent-key-if-using-storage>
CORS_ORIGINS=https://e-gov-v5.vercel.app,https://e-gov-v5-git-master.vercel.app

# ===========================================
# VERCEL DEPLOYMENT NOTES
# ===========================================
# 1. Go to: https://vercel.com/raksyz-porto/e-gov-v5/settings/environment-variables
# 2. Add each variable for "Production" and "Preview" environments
# 3. Redeploy after adding variables (Settings → Deployments → Redeploy)
# 4. Verify build logs show no "Missing Supabase credentials" errors
#
# SECURITY:
# - Never commit .env.local to git
# - Rotate Supabase key if old key was exposed in git history
# - Use strong JWT_SECRET (min 32 chars, random)
# - Keep ADMIN_PASSWORD secure, change after first deploy
